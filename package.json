{
  "name": "rookieclip",
  "private": true,
  "version": "1.0.7",
  "type": "commonjs",
  "main": "src/main/main.js",
  "author": {
    "name": "Shreya Srivastava"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node test/engine.test.js && node test/tracker.test.js",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.rookieclip.rookieclipstudio",
    "productName": "RookieClip",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!node_modules/.vite/**",
      "!*.log",
       "!.github/**"
    ],
    "asar": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "src/assets/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "publish": [
    {
      "provider": "github",
      "owner": "this-is-shreya",
      "repo": "video-editor-desktop"
    }
  ],
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@uploadthing/react": "^7.3.3",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "driver.js": "^1.9.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.19.0",
    "koffi": "^3.3.2",
    "lucide-react": "^1.52.0",
    "ogl": "^1.0.11",
    "posthog-js": "^1.435.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4",
    "recordrtc": "^5.6.2",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
